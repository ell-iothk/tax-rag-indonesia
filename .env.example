# ==========================================================
# Docker — password database dan secret Langfuse
# Dibutuhkan docker-compose.yml
# ==========================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse

CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# generate dengan:
#   openssl rand -base64 32   -> NEXTAUTH_SECRET dan SALT
#   openssl rand -hex 32      -> ENCRYPTION_KEY (WAJIB hex 64 karakter)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# ==========================================================
# Langfuse — API key project. BOLEH DIKOSONGKAN.
# Tanpa ini sistem tetap jalan, hanya tracing yang nonaktif.
#
# Cara mendapatkannya:
#   1. docker compose up -d
#   2. buka http://localhost:3000, buat akun dan project
#   3. Settings > API Keys > Create new API keys
# ==========================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
